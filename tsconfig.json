{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2022",

		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"isolatedDeclarations": true,
		// "erasableSyntaxOnly": true,

		"rootDir": "src",
		"outDir": "dist",

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"incremental": true,

		"noEmit": true,

		"moduleDetection": "force"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build"]
}
