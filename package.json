{
	"name": "color-fns",
	"version": "0.2.0",
	"description": "Functional color utility library",
	"repository": "https://github.com/ajlende/color-fns",
	"license": "MIT",
	"author": "Alex Lende <alex+npm@lende.xyz>",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./formats/*.js": {
			"import": "./dist/formats/*.js",
			"types": "./dist/formats/*.d.ts"
		},
		"./operations/*.js": {
			"import": "./dist/operations/*.js",
			"types": "./dist/operations/*.d.ts"
		},
		"./formats/hex/*.js": {
			"import": "./dist/formats/hex/*.js",
			"types": "./dist/formats/hex/*.d.ts"
		},
		"./formats/hsl/*.js": {
			"import": "./dist/formats/hsl/*.js",
			"types": "./dist/formats/hsl/*.d.ts"
		},
		"./formats/hslCss/*.js": {
			"import": "./dist/formats/hslCss/*.js",
			"types": "./dist/formats/hslCss/*.d.ts"
		},
		"./formats/hslString/*.js": {
			"import": "./dist/formats/hslString/*.js",
			"types": "./dist/formats/hslString/*.d.ts"
		},
		"./formats/hsv/*.js": {
			"import": "./dist/formats/hsv/*.js",
			"types": "./dist/formats/hsv/*.d.ts"
		},
		"./formats/rgb/*.js": {
			"import": "./dist/formats/rgb/*.js",
			"types": "./dist/formats/rgb/*.d.ts"
		},
		"./formats/rgbCss/*.js": {
			"import": "./dist/formats/rgbCss/*.js",
			"types": "./dist/formats/rgbCss/*.d.ts"
		},
		"./formats/rgbString/*.js": {
			"import": "./dist/formats/rgbString/*.js",
			"types": "./dist/formats/rgbString/*.d.ts"
		},
		"./formats/vec4/*.js": {
			"import": "./dist/formats/vec4/*.js",
			"types": "./dist/formats/vec4/*.d.ts"
		}
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "^18.18.0 || ^20.9.0 || >=21.1.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "ava --watch",
		"docs": "typedoc && typedoc --json docs/api.json",
		"test": "c8 ava",
		"clean": "concurrently \"npm:clean:*\" --prefix-colors=auto --group",
		"clean:build": "rm -rf dist",
		"clean:docs": "rm -rf docs docs/api docs/api.json",
		"clean:test": "rm -rf coverage",
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint --fix",
		"format:prettier": "prettier --write --list-different .",
		"check": "concurrently \"npm:check:*\" --prefix-colors=auto --group",
		"check:eslint": "eslint",
		"check:prettier": "prettier --check .",
		"check:types": "tsc --noEmit",
		"prepare": "husky || true",
		"prepublish": "npm run clean:build && npm run build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.8",
		"@septh/ts-run": "^2.0.0",
		"@types/node": "^22.14.1",
		"ava": "^6.2.0",
		"c8": "^10.1.3",
		"concurrently": "^9.1.2",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-ava": "^15.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "3.5.3",
		"typedoc": "^0.28.2",
		"typedoc-plugin-markdown": "^4.6.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.30.1"
	}
}