{
	"name": "color-fns",
	"version": "0.2.0",
	"description": "Functional color utility library",
	"repository": "https://github.com/ajlende/color-fns",
	"license": "MIT",
	"author": "Alex Lende <alex+npm@lende.xyz>",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./core/*.js": {
			"import": "./dist/core/*.js",
			"types": "./dist/core/*.d.ts"
		},
		"./format/*.js": {
			"import": "./dist/format/*.js",
			"types": "./dist/format/*.d.ts"
		},
		"./format/color-space/*.js": {
			"import": "./dist/format/color-space/*.js",
			"types": "./dist/format/color-space/*.d.ts"
		},
		"./format/data/*.js": {
			"import": "./dist/format/data/*.js",
			"types": "./dist/format/data/*.d.ts"
		},
		"./format/string/*.js": {
			"import": "./dist/format/string/*.js",
			"types": "./dist/format/string/*.d.ts"
		},
		"./format/color-space/hsl/*.js": {
			"import": "./dist/format/color-space/hsl/*.js",
			"types": "./dist/format/color-space/hsl/*.d.ts"
		},
		"./format/color-space/hsv/*.js": {
			"import": "./dist/format/color-space/hsv/*.js",
			"types": "./dist/format/color-space/hsv/*.d.ts"
		},
		"./format/color-space/rgb/*.js": {
			"import": "./dist/format/color-space/rgb/*.js",
			"types": "./dist/format/color-space/rgb/*.d.ts"
		},
		"./format/data/vec4/*.js": {
			"import": "./dist/format/data/vec4/*.js",
			"types": "./dist/format/data/vec4/*.d.ts"
		},
		"./format/string/hex/*.js": {
			"import": "./dist/format/string/hex/*.js",
			"types": "./dist/format/string/hex/*.d.ts"
		},
		"./format/string/hslString/*.js": {
			"import": "./dist/format/string/hslString/*.js",
			"types": "./dist/format/string/hslString/*.d.ts"
		},
		"./format/string/rgbString/*.js": {
			"import": "./dist/format/string/rgbString/*.js",
			"types": "./dist/format/string/rgbString/*.d.ts"
		}
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "^18.18.0 || ^20.9.0 || >=21.1.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "ava --watch",
		"docs": "typedoc",
		"test": "c8 ava",
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint --fix",
		"format:prettier": "prettier --write --list-different .",
		"check": "concurrently \"npm:check:*\" --prefix-colors=auto --group",
		"check:eslint": "eslint",
		"check:prettier": "prettier --check .",
		"check:types": "tsc --noEmit",
		"prepare": "husky || true",
		"prepublish": "rm -rf dist && npm run build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.8",
		"@eslint/js": "^9.24.0",
		"@septh/ts-run": "^2.0.0",
		"ava": "^6.2.0",
		"c8": "^10.1.3",
		"concurrently": "^9.1.2",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-ava": "^15.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "3.5.3",
		"typedoc": "^0.28.2",
		"typedoc-plugin-markdown": "^4.6.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.30.1"
	},
	"dependencies": {
		"@types/node": "^22.14.1"
	}
}
